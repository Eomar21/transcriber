<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transcriber.Services\Transcriber.Services.csproj" />
    <ProjectReference Include="..\Transcriber.ViewModels\Transcriber.ViewModels.csproj" />
    <ProjectReference Include="..\Transcriber.Coach\Transcriber.Coach.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Audio samples + manifest.json (reference transcripts), copied next to the test assembly. -->
    <Content Include="TestData\**\*.mp3;TestData\**\*.wav;TestData\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Gives the tests the same bundled ffmpeg the app ships with (see build\BundledAssets.targets). -->
  <Import Project="..\build\BundledAssets.targets" />

</Project>
