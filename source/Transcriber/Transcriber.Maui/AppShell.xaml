<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Transcriber.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Transcriber.Maui"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Transcriber">

    <!-- Each feature is a tab. -->
    <TabBar>
        <ShellContent
            Title="Transcribe"
            ContentTemplate="{DataTemplate local:TranscribePage}"
            Route="transcribe" />

        <ShellContent
            Title="Practice"
            ContentTemplate="{DataTemplate local:PracticePage}"
            Route="practice" />
    </TabBar>

</Shell>
