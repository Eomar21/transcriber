<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Transcriber.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Transcriber.Maui"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Transcriber">

    <!-- Each feature is a tab. With a single tab Shell hides the tab bar. -->
    <ShellContent
        Title="Transcribe"
        ContentTemplate="{DataTemplate local:TranscribePage}"
        Route="transcribe" />

</Shell>
