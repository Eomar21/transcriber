<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Transcriber.Maui.Controls.PageHeader"
    x:Name="Root">

    <!-- The title of a screen and the one line under it. -->
    <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
        <Label Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource PageTitle}" />
        <Label Text="{Binding Subtitle, Source={x:Reference Root}}" Style="{StaticResource Caption}" />
    </VerticalStackLayout>
</ContentView>
