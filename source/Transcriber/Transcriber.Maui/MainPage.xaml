<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Transcriber.Maui.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="16" MaximumWidthRequest="900">

            <Label Text="Transcriber" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Private, offline transcription. Audio never leaves your computer."
                   FontSize="13" HorizontalOptions="Center" />

            <!-- Files -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry x:Name="FilePathEntry" Placeholder="No files chosen yet" IsReadOnly="True" />
                <Button x:Name="BrowseButton" Grid.Column="1" Text="Browse..." Clicked="OnBrowseClicked" />
            </Grid>

            <!-- Options -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <VerticalStackLayout>
                    <Label Text="Language" FontSize="12" />
                    <Picker x:Name="LanguagePicker" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Model (bigger = more accurate, slower)" FontSize="12" />
                    <Picker x:Name="ModelPicker" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2">
                    <Label Text="Save as" FontSize="12" />
                    <Picker x:Name="FormatPicker" />
                </VerticalStackLayout>
            </Grid>

            <Entry x:Name="PromptEntry"
                   Placeholder="Optional: names or special terms to help recognition (e.g. Eindhoven, Dr. Haddad)" />

            <HorizontalStackLayout Spacing="8">
                <Switch x:Name="GpuSwitch" IsToggled="True" />
                <Label Text="Use GPU when available (falls back to CPU automatically; change applies after restarting the app)" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Actions -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button x:Name="ProcessButton" Text="Transcribe" Clicked="OnProcessClicked" />
                <Button x:Name="CancelButton" Grid.Column="1" Text="Cancel" IsVisible="False" Clicked="OnCancelClicked" />
            </Grid>

            <!-- Progress -->
            <VerticalStackLayout x:Name="ProgressPanel" IsVisible="False" Spacing="4">
                <ProgressBar x:Name="ProgressBar" Progress="0" />
                <Label x:Name="StatusLabel" FontSize="13" />
            </VerticalStackLayout>

            <Label x:Name="TranscriptLocationLabel" TextColor="Green" FontAttributes="Bold" />

            <!-- Results -->
            <VerticalStackLayout x:Name="ResultsPanel" IsVisible="False" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <SearchBar x:Name="SearchBox" Placeholder="Search the transcript" TextChanged="OnSearchChanged" />
                    <Button Grid.Column="1" Text="Copy all" Clicked="OnCopyClicked" />
                </Grid>
                <CollectionView x:Name="SegmentsView" HeightRequest="320">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="90,*" Padding="0,4">
                                <Label Text="{Binding Time}" TextColor="Gray" FontSize="12" />
                                <Label Grid.Column="1" Text="{Binding Text}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
