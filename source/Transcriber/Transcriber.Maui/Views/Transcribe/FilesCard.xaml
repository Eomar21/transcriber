<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Transcribe;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Transcribe.FilesCard"
    x:DataType="vm:FilesViewModel">

    <!-- 1. Files -->
    <Border Style="{StaticResource Card}">
        <Border.Triggers>
            <!-- Highlight the card while files are dragged over the window. -->
            <DataTrigger TargetType="Border" Binding="{Binding IsDragOver}" Value="True">
                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                <Setter Property="StrokeThickness" Value="2" />
            </DataTrigger>
        </Border.Triggers>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource SpaceXs}">
                <Label Text="Files" Style="{StaticResource SectionTitle}" />
                <Label AutomationId="FilesSummary" Text="{Binding FilesSummary}" Style="{StaticResource Body}" LineBreakMode="MiddleTruncation" />
                <Label Text="Drop files here, or choose them. mp3, wav, mp4, mov, m4a and more" Style="{StaticResource Caption}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsDragOver}" Value="True">
                            <Setter Property="Text" Value="Release to add these files" />
                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Button AutomationId="AnyFileButton" Text="Any file type" Style="{StaticResource LinkButton}"
                        Command="{Binding BrowseAnyCommand}" IsEnabled="{Binding IsIdle}"
                        SemanticProperties.Description="Choose a file of any type. The app tries to read it."
                        ToolTipProperties.Text="Show files of every type. The app tries to read the file you choose." />
                <Label AutomationId="DropMessage" Text="{Binding DropMessage, StringFormat='&#x26A0;  {0}'}" TextColor="{StaticResource WarningColor}"
                       FontSize="13" IsVisible="{Binding HasDropMessage}" />
            </VerticalStackLayout>
            <Button AutomationId="ClearFilesButton" Grid.Column="1" Text="Clear" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearFilesCommand}" IsVisible="{Binding HasFiles}" />
            <Button AutomationId="ChooseFilesButton" Grid.Column="2" Text="Choose files" Style="{StaticResource PrimaryButton}"
                    Command="{Binding BrowseCommand}" IsEnabled="{Binding IsIdle}" />
        </Grid>
    </Border>
</ContentView>
