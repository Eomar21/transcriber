<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Transcribe;assembly=Transcriber.ViewModels"
    xmlns:models="clr-namespace:Transcriber.ViewModels;assembly=Transcriber.ViewModels"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    x:Class="Transcriber.Maui.Views.Transcribe.OptionsCard"
    x:DataType="vm:OptionsViewModel">

    <!-- 2. Settings (wraps onto new rows when the window is narrow) -->
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="{StaticResource SpaceLg}">
            <Label Text="Settings" Style="{StaticResource SectionTitle}" />

            <!-- Three equal columns, so a long choice or hint stays inside its column: the hint wraps and the choice is cut with an ellipsis. -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceMd}">
                <VerticalStackLayout>
                    <material:PickerField Title="Language" ToolTipProperties.Text="Auto-detect picks the language from each stretch of speech. If a recording mixes languages, part of it can be missing. For the best result, select the main language." AutomationId="LanguagePicker" ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage}" IsEnabled="{Binding IsIdle}" />
                    <!-- Only shown when a bigger model would be clearly more accurate for the chosen language. -->
                    <VerticalStackLayout IsVisible="{Binding HasLanguageAdvice}" Spacing="{StaticResource SpaceSm}" Margin="0,4,0,0">
                        <Label AutomationId="LanguageAdvice" Text="{Binding LanguageAdvice}" Style="{StaticResource Caption}" TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                        <Button AutomationId="UseMediumButton" Text="{Binding UseSuggestedModelText}" StyleClass="FilledTonalButton,Small"
                                HorizontalOptions="Start" Command="{Binding UseSuggestedModelCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <material:PickerField Title="Model" ToolTipProperties.Text="A bigger model is more accurate, but slower." AutomationId="ModelPicker" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModelOption}" IsEnabled="{Binding IsIdle}" />
                    <Label AutomationId="ModelHint" Text="{Binding ModelHint}" Style="{StaticResource Caption}" TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" IsVisible="{Binding HasModelHint}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2">
                    <material:PickerField Title="Save as" ItemsSource="{Binding Formats}"
                            SelectedItem="{Binding SelectedFormat}" IsEnabled="{Binding IsIdle}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout>
                <material:TextField Title="Names or special terms (optional, improves recognition)" Text="{Binding Prompt}" IsEnabled="{Binding IsIdle}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="{StaticResource SpaceMd}">
                <Switch IsToggled="{Binding UseGpu}" IsEnabled="{Binding IsIdle}" VerticalOptions="Center" />
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Use graphics card when available" Style="{StaticResource Body}" />
                    <Label Text="Falls back to the processor automatically. A change applies after restarting the app." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource SpaceSm}" IsVisible="{Binding CanIdentifySpeakers}">
                <HorizontalStackLayout Spacing="{StaticResource SpaceMd}">
                    <Switch AutomationId="IdentifySpeakersSwitch" IsToggled="{Binding IdentifySpeakers}" IsEnabled="{Binding IsIdle}" VerticalOptions="Center" />
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Label who is speaking" Style="{StaticResource Body}" />
                        <Label Text="Marks each line as Speaker 1, Speaker 2 and so on. Adds some processing time." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <material:PickerField Title="Number of speakers" AutomationId="SpeakerCountPicker" IsVisible="{Binding IdentifySpeakers}" IsEnabled="{Binding IsIdle}"
                        ItemsSource="{Binding SpeakerCounts}"
                        SelectedItem="{Binding SelectedSpeakerCount}" WidthRequest="260" HorizontalOptions="Start" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
