<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Transcribe;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Transcribe.ProgressCard"
    x:DataType="vm:RunStatusViewModel">

    <!-- Progress. The page shows this view only while a run is in progress. -->
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
            <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Primary}" />
            <Label Text="{Binding StatusText}" Style="{StaticResource Body}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
