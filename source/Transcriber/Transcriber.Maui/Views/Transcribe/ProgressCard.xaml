<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Transcriber.Maui.Controls"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Transcribe;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Transcribe.ProgressCard"
    x:DataType="vm:RunStatusViewModel">

    <!-- Progress. The page shows this view while a run is in progress, and for a moment after it, so the finish can be seen. -->
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="{StaticResource SpaceSm}">
            <controls:RunnerProgress Progress="{Binding Progress}" Look="{Binding Look}" FillColor="{StaticResource Primary}"
                                     TrackColor="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
            <Label Text="{Binding StatusText}" Style="{StaticResource Body}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
