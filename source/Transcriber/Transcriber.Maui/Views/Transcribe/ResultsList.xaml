<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Transcribe;assembly=Transcriber.ViewModels"
    xmlns:models="clr-namespace:Transcriber.ViewModels;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Transcribe.ResultsList"
    x:DataType="vm:ResultsViewModel">

    <CollectionView AutomationId="Segments" ItemsSource="{Binding VisibleSegments}" HeightRequest="340"
                    SelectionMode="Single" SelectedItem="{Binding SelectedSegment}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:SegmentItem">
                <Grid ColumnDefinitions="110,*" ColumnSpacing="8" Padding="6,5" SemanticProperties.Description="{Binding Text}" SemanticProperties.Hint="Click to play from this line">
                    <Grid.Triggers>
                        <!-- The line being played right now. -->
                        <DataTrigger TargetType="Grid" Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ActiveRowLight}, Dark={StaticResource ActiveRowDark}}" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <VerticalStackLayout Spacing="2" VerticalOptions="Start">
                        <Label Text="{Binding Time}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding SpeakerLabel}" IsVisible="{Binding HasSpeaker}" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
