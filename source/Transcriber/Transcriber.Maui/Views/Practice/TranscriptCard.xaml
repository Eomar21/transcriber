<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Practice;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Practice.TranscriptCard"
    x:DataType="vm:AnalysisViewModel">

    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
            <Label Text="What was heard" Style="{StaticResource SectionTitle}" />
            <Label Text="Check the numbers against your words. Filler words only count if the transcript kept them." Style="{StaticResource Caption}" />
            <Label AutomationId="PracticeTranscript" Text="{Binding Transcript}" Style="{StaticResource Body}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </Border>
</ContentView>
