<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Practice;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Practice.TipsCard"
    x:DataType="vm:AnalysisViewModel">

    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="12">
            <Label Text="What to work on" Style="{StaticResource SectionTitle}" />
            <VerticalStackLayout AutomationId="PracticeTips" Spacing="12" BindableLayout.ItemsSource="{Binding Tips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TipItem">
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                            <Label Text="{Binding Symbol}" FontAttributes="Bold" FontSize="16" VerticalOptions="Start" HorizontalTextAlignment="Center"
                                   SemanticProperties.Description="{Binding Kind}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Good">
                                        <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Improve">
                                        <Setter Property="TextColor" Value="{StaticResource WarningColor}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Info">
                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" Style="{StaticResource Body}" />
                                <Label Text="{Binding Detail}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
