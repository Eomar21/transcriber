<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Practice;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Practice.TipsCard"
    x:DataType="vm:AnalysisViewModel">

    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="{StaticResource SpaceLg}">
            <Label Text="What to work on" Style="{StaticResource SectionTitle}" />
            <VerticalStackLayout AutomationId="PracticeTips" Spacing="{StaticResource SpaceMd}" BindableLayout.ItemsSource="{Binding Tips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TipItem">
                        <Border Style="{StaticResource Tile}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="Good">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessTintLight}, Dark={StaticResource SuccessTintDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="Improve">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarningTintLight}, Dark={StaticResource WarningTintDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="{StaticResource SpaceSm}">
                            <Label Text="{Binding Symbol}" FontAttributes="Bold" FontSize="16" VerticalOptions="Start" HorizontalTextAlignment="Center"
                                   SemanticProperties.Description="{Binding Kind}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Good">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Improve">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="Info">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                                <Label Text="{Binding Title}" FontAttributes="Bold" Style="{StaticResource Body}" />
                                <Label Text="{Binding Detail}" Style="{StaticResource Caption}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
