<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Practice;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Practice.HistoryCard"
    x:DataType="vm:HistoryViewModel">

    <!-- 4. History -->
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="{StaticResource SpaceLg}">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource SpaceXs}">
                    <Label Text="Your progress" Style="{StaticResource SectionTitle}" />
                    <Label Text="Past practice runs, newest first. Saved only on this computer." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Clear all" Style="{StaticResource SmallButton}" Command="{Binding ClearHistoryCommand}" />
            </Grid>
            <VerticalStackLayout AutomationId="PracticeHistory" Spacing="{StaticResource SpaceSm}" BindableLayout.ItemsSource="{Binding Sessions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionItem">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}" Padding="0,4">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="{Binding Title}" Style="{StaticResource Body}" LineBreakMode="MiddleTruncation" />
                                <Label Text="{Binding When}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Delete" Style="{StaticResource SmallButton}" VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteSessionCommand, x:DataType=vm:HistoryViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
