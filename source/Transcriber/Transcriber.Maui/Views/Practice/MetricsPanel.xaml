<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Practice;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.Views.Practice.MetricsPanel"
    x:DataType="vm:AnalysisViewModel">

    <!-- The tiles are built in the code-behind so they can reflow between 5 and 3 columns. -->
    <Grid x:Name="MetricsGrid" AutomationId="PracticeMetrics" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceMd}" />
</ContentView>
