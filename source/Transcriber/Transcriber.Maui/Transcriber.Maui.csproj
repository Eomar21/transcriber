<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Desktop app: each machine builds its own platform, so no Android/iOS workloads are needed. -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Transcriber.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Transcriber.Maui</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.transcriber.maui</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Transcriber.Services\Transcriber.Services.csproj" />
	  <ProjectReference Include="..\Transcriber.ViewModels\Transcriber.ViewModels.csproj" />
	</ItemGroup>

	<!-- Bundles ffmpeg and the default Whisper model with the app (see build\BundledAssets.targets). -->
	<PropertyGroup>
		<BundleWhisperModel>true</BundleWhisperModel>
	</PropertyGroup>
	<Import Project="..\build\BundledAssets.targets" />


	<!--
		Whisper.net.Runtime ships native libraries for every OS. The Mac Catalyst toolchain tries to
		post-process them and fails. Whisper.net links its static Mac Catalyst libraries itself, so drop all of them.
	-->
	<Target Name="DropDynamicWhisperRuntimesOnMac" BeforeTargets="_ComputeDynamicLibrariesToReidentify"
	        Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'">
		<ItemGroup>
			<_OtherOsNative Include="@(_FileNativeReference);@(ResolvedFileToPublish)"
			                Condition="('%(Extension)' == '.dylib' Or '%(Extension)' == '.so' Or '%(Extension)' == '.dll') And ($([System.String]::Copy('%(Filename)').StartsWith('libwhisper')) Or $([System.String]::Copy('%(Filename)').StartsWith('libggml')) Or $([System.String]::Copy('%(Filename)').StartsWith('whisper')) Or $([System.String]::Copy('%(Filename)').StartsWith('ggml')))" />
			<_FileNativeReference Remove="@(_OtherOsNative)" />
			<ResolvedFileToPublish Remove="@(_OtherOsNative)" />
		</ItemGroup>
	</Target>


	<!--
		Whisper.net ships static Mac Catalyst libraries. Reference them here so they are always linked into the app
		(the package's own build targets are not picked up through the class library reference).
	-->
	<PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'">
		<WhisperMacLibDir>$(NuGetPackageRoot)whisper.net.runtime/1.9.1/build/maccatalyst/</WhisperMacLibDir>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst' And Exists('$(WhisperMacLibDir)libwhisper.a')">
		<NativeReference Include="$(WhisperMacLibDir)libwhisper.a">
			<Kind>Static</Kind>
			<SmartLink>true</SmartLink>
			<ForceLoad>true</ForceLoad>
			<Frameworks>Accelerate</Frameworks>
		</NativeReference>
		<NativeReference Include="$(WhisperMacLibDir)libggml-whisper.a">
			<Kind>Static</Kind>
			<SmartLink>true</SmartLink>
		</NativeReference>
		<NativeReference Include="$(WhisperMacLibDir)libggml-base-whisper.a">
			<Kind>Static</Kind>
			<SmartLink>true</SmartLink>
		</NativeReference>
		<NativeReference Include="$(WhisperMacLibDir)libggml-cpu-whisper.a">
			<Kind>Static</Kind>
			<SmartLink>true</SmartLink>
		</NativeReference>
		<NativeReference Include="$(WhisperMacLibDir)libggml-blas-whisper.a">
			<Kind>Static</Kind>
			<SmartLink>true</SmartLink>
			<Frameworks>Accelerate</Frameworks>
		</NativeReference>
	</ItemGroup>

</Project>
