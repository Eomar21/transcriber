<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Transcriber.Maui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="Transcriber.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Our palette, in the names of the Material colour system. -->
                <ResourceDictionary x:Name="appColors" Source="Resources/Styles/Colors.xaml" />
                <!-- 2. The Material look of UraniumUI, built on our palette. -->
                <material:StyleResource ColorsOverride="{x:Reference appColors}" />
                <!-- 3. Our own design tokens and named styles. They come last, so they win over the library. -->
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
