<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Transcribe;assembly=Transcriber.ViewModels"
    xmlns:views="clr-namespace:Transcriber.Maui.Views.Transcribe"
    x:Class="Transcriber.Maui.TranscribePage"
    x:DataType="vm:TranscribeViewModel"
    Title="Transcribe">

    <!-- The page only arranges the sections. Each section is a view with its own view model. -->
    <ScrollView>
      <!-- Centred column; its width is capped in the code-behind (see OnSizeAllocated). -->
      <VerticalStackLayout x:Name="Column" HorizontalOptions="Center" Margin="0,24" Spacing="{StaticResource SpaceLg}">

            <!-- Header -->
            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                <Label Text="Transcriber" Style="{StaticResource PageTitle}" />
                <Label Text="Private, offline transcription. Your audio never leaves this computer." Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <!-- 1. Files -->
            <views:FilesCard BindingContext="{Binding Files}" />

            <!-- 2. Settings -->
            <views:OptionsCard BindingContext="{Binding Options}" />

            <!-- 3. Action -->
            <Grid ColumnDefinitions="*,Auto">
                <Button AutomationId="TranscribeButton" Text="Transcribe" Style="{StaticResource PrimaryButton}" Command="{Binding TranscribeCommand}" />
                <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        Command="{Binding TranscribeCancelCommand}" IsVisible="{Binding IsBusy}" />
            </Grid>

            <!-- Progress: only while a run is in progress. -->
            <views:ProgressCard BindingContext="{Binding Status}" IsVisible="{Binding IsBusy, x:DataType=vm:RunStatusViewModel}" />

            <!-- Result: the status line and notes, then the buttons for the saved transcript. -->
            <VerticalStackLayout IsVisible="{Binding Status.HasResultMessage}" Spacing="{StaticResource SpaceSm}">
                <views:RunStatusView BindingContext="{Binding Status}" />
                <views:SavedTranscriptsView BindingContext="{Binding Saved}" />
            </VerticalStackLayout>

            <!-- 4. Results -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding Results.HasResults}">
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                    <views:ResultsToolbar BindingContext="{Binding Results}" />
                    <views:PlayerBar BindingContext="{Binding Playback}" />
                    <views:ResultsList BindingContext="{Binding Results}" />
                </VerticalStackLayout>
            </Border>

      </VerticalStackLayout>
    </ScrollView>
</ContentPage>
