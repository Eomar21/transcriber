<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels.Transcribe;assembly=Transcriber.ViewModels"
    xmlns:controls="clr-namespace:Transcriber.Maui.Controls"
    xmlns:views="clr-namespace:Transcriber.Maui.Views.Transcribe"
    x:Class="Transcriber.Maui.TranscribePage"
    x:DataType="vm:TranscribeViewModel"
    Title="Transcribe">

    <!-- The page only arranges the sections. Each section is a view with its own view model. -->
    <controls:PageColumn x:Name="Scroller" AutomationId="PageScroller">
      <VerticalStackLayout x:Name="Column" Margin="0,24" Spacing="{StaticResource SpaceLg}">

            <!-- Header -->
            <controls:PageHeader Title="Transcriber" Subtitle="Private, offline transcription. Your audio never leaves this computer." />

            <!-- 1. Files -->
            <views:FilesCard BindingContext="{Binding Files}" />

            <!-- 2. Settings -->
            <views:OptionsCard BindingContext="{Binding Options}" />

            <!-- 3. Action -->
            <Grid ColumnDefinitions="*,Auto">
                <Button AutomationId="TranscribeButton" Text="Transcribe" StyleClass="FilledButton,Large" Command="{Binding TranscribeCommand}" />
                <Button Grid.Column="1" Text="Cancel" StyleClass="OutlinedButton,Large" Margin="12,0,0,0"
                        Command="{Binding TranscribeCancelCommand}" IsVisible="{Binding IsBusy}" />
            </Grid>

            <!-- Progress: only while a run is in progress. -->
            <views:ProgressCard x:Name="ProgressView" AutomationId="RunProgress" BindingContext="{Binding Status}" IsVisible="{Binding ShowProgress, x:DataType=vm:RunStatusViewModel}" />

            <!-- Result: the status line and notes, then the buttons for the saved transcript. -->
            <VerticalStackLayout IsVisible="{Binding Status.HasResultMessage}" Spacing="{StaticResource SpaceSm}">
                <views:RunStatusView BindingContext="{Binding Status}" />
                <views:SavedTranscriptsView BindingContext="{Binding Saved}" />
            </VerticalStackLayout>

            <!-- 4. Results -->
            <Border x:Name="ResultsCard" Style="{StaticResource Card}" IsVisible="{Binding Results.HasResults}">
                <VerticalStackLayout Spacing="{StaticResource SpaceMd}">
                    <views:ResultsToolbar BindingContext="{Binding Results}" />
                    <views:PlayerBar BindingContext="{Binding Playback}" />
                    <views:ResultsList BindingContext="{Binding Results}" />
                </VerticalStackLayout>
            </Border>

      </VerticalStackLayout>
    </controls:PageColumn>
</ContentPage>
