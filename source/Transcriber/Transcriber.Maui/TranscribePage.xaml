<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Transcriber.ViewModels;assembly=Transcriber.ViewModels"
    x:Class="Transcriber.Maui.TranscribePage"
    x:DataType="vm:TranscribeViewModel"
    Title="Transcribe">

    <ScrollView>
      <!-- Centred column; its width is capped in the code-behind (see OnSizeAllocated). -->
      <VerticalStackLayout x:Name="Column" HorizontalOptions="Center" Margin="0,24" Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Transcriber" Style="{StaticResource PageTitle}" />
                <Label Text="Private, offline transcription. Your audio never leaves this computer." Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <!-- 1. Files -->
            <Border Style="{StaticResource Card}">
                <Border.Triggers>
                    <!-- Highlight the card while files are dragged over the window. -->
                    <DataTrigger TargetType="Border" Binding="{Binding IsDragOver}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Files" Style="{StaticResource SectionTitle}" />
                        <Label AutomationId="FilesSummary" Text="{Binding FilesSummary}" Style="{StaticResource Body}" LineBreakMode="MiddleTruncation" />
                        <Label Text="Drop files here, or choose them. mp3, wav, mp4, mov, m4a and more" Style="{StaticResource Caption}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsDragOver}" Value="True">
                                    <Setter Property="Text" Value="Release to add these files" />
                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label AutomationId="DropMessage" Text="{Binding DropMessage, StringFormat='&#x26A0;  {0}'}" TextColor="{StaticResource WarningColor}"
                               FontSize="13" IsVisible="{Binding HasDropMessage}" />
                    </VerticalStackLayout>
                    <Button AutomationId="ClearFilesButton" Grid.Column="1" Text="Clear" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearFilesCommand}" IsVisible="{Binding HasFiles}" />
                    <Button AutomationId="ChooseFilesButton" Grid.Column="2" Text="Choose files" Style="{StaticResource PrimaryButton}"
                            Command="{Binding BrowseCommand}" IsEnabled="{Binding IsIdle}" />
                </Grid>
            </Border>

            <!-- 2. Settings (wraps onto new rows when the window is narrow) -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Settings" Style="{StaticResource SectionTitle}" />

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                        <VerticalStackLayout FlexLayout.Basis="250" FlexLayout.Grow="1" Margin="0,0,12,10">
                            <Label Text="Language" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding Languages}" ItemDisplayBinding="{Binding Name, x:DataType=vm:LanguageOption}"
                                    SelectedItem="{Binding SelectedLanguage}" IsEnabled="{Binding IsIdle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout FlexLayout.Basis="250" FlexLayout.Grow="1" Margin="0,0,12,10">
                            <Label Text="Model (bigger is more accurate, slower)" Style="{StaticResource Caption}" />
                            <Picker AutomationId="ModelPicker" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModelOption}" IsEnabled="{Binding IsIdle}" />
                            <Label AutomationId="ModelHint" Text="{Binding ModelHint}" Style="{StaticResource Caption}" TextColor="{StaticResource WarningColor}" IsVisible="{Binding HasModelHint}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout FlexLayout.Basis="250" FlexLayout.Grow="1" Margin="0,0,0,10">
                            <Label Text="Save as" Style="{StaticResource Caption}" />
                            <Picker ItemsSource="{Binding Formats}" ItemDisplayBinding="{Binding Label, x:DataType=vm:FormatOption}"
                                    SelectedItem="{Binding SelectedFormat}" IsEnabled="{Binding IsIdle}" />
                        </VerticalStackLayout>
                    </FlexLayout>

                    <VerticalStackLayout>
                        <Label Text="Names or special terms (optional, improves recognition)" Style="{StaticResource Caption}" />
                        <Entry Text="{Binding Prompt}" Placeholder="e.g. Eindhoven, Dr. Haddad" IsEnabled="{Binding IsIdle}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Switch IsToggled="{Binding UseGpu}" IsEnabled="{Binding IsIdle}" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Use graphics card when available" Style="{StaticResource Body}" />
                            <Label Text="Falls back to the processor automatically. A change applies after restarting the app." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Action -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button AutomationId="TranscribeButton" Text="Transcribe" Style="{StaticResource PrimaryButton}" Command="{Binding TranscribeCommand}" />
                <Button Grid.Column="1" Text="Cancel" Style="{StaticResource SecondaryButton}"
                        Command="{Binding TranscribeCancelCommand}" IsVisible="{Binding IsBusy}" />
            </Grid>

            <!-- Progress -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsBusy}">
                <VerticalStackLayout Spacing="8">
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Primary}" />
                    <Label Text="{Binding StatusText}" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>

            <!-- Result: plain status line (icon + text), path and runtime as captions, then real buttons. -->
            <VerticalStackLayout IsVisible="{Binding HasResultMessage}" Spacing="6">
                <HorizontalStackLayout Spacing="8">
                    <Label x:Name="StatusIcon" FontAttributes="Bold" VerticalOptions="Center"
                           SemanticProperties.Description="Status">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ResultKind}" Value="Success">
                                <Setter Property="Text" Value="&#x2713;" />
                                <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding ResultKind}" Value="Error">
                                <Setter Property="Text" Value="!" />
                                <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label AutomationId="ResultMessage" Text="{Binding ResultMessage}" Style="{StaticResource Body}" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label AutomationId="ResultDetail" Text="{Binding ResultDetail}" Style="{StaticResource Caption}" LineBreakMode="MiddleTruncation"
                       ToolTipProperties.Text="{Binding ResultDetail}" IsVisible="{Binding HasResultDetail}" />
                <Label Text="{Binding RuntimeNote}" Style="{StaticResource Caption}" IsVisible="{Binding HasRuntimeNote}" />

                <HorizontalStackLayout Spacing="10" Margin="0,4,0,0" IsVisible="{Binding HasSavedFiles}">
                    <Button AutomationId="OpenTranscriptButton" Text="Open transcript" Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenTranscriptCommand}" IsVisible="{Binding CanOpenTranscript}"
                            SemanticProperties.Description="Open the saved transcript in its default app" />
                    <Button AutomationId="ShowInFolderButton" Text="{Binding ShowInFolderLabel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowInFolderCommand}"
                            SemanticProperties.Description="Show the saved transcript in its folder">
                        <Button.Triggers>
                            <!-- For a batch there is no "Open", so the folder action becomes the primary one. -->
                            <DataTrigger TargetType="Button" Binding="{Binding CanOpenTranscript}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderWidth" Value="0" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <Label AutomationId="ActionMessage" Text="{Binding ActionMessage, StringFormat='&#x26A0;  {0}'}" TextColor="{StaticResource WarningColor}"
                       FontSize="13" IsVisible="{Binding HasActionMessage}" />
            </VerticalStackLayout>

            <!-- 4. Results -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasResults}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <SearchBar Placeholder="Search the transcript" Text="{Binding SearchText}" />
                        <Button Grid.Column="1" Text="Copy all" Style="{StaticResource SecondaryButton}" Command="{Binding CopyAllCommand}" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding VisibleSegments}" HeightRequest="340">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SegmentItem">
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="8" Padding="0,5">
                                    <Label Text="{Binding Time}" Style="{StaticResource Caption}" VerticalOptions="Start" />
                                    <Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

      </VerticalStackLayout>
    </ScrollView>
</ContentPage>
