<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->
    <!-- The palette of the app, in the names of the Material colour system that UraniumUI reads. A name with "Dark" is the dark mode value.
         Change the brand look here and nowhere else. -->
    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#C9BEFF</Color>
    <Color x:Key="PrimaryContainer">#E7DFFF</Color>
    <Color x:Key="PrimaryContainerDark">#3B1FA8</Color>
    <Color x:Key="Secondary">#5E5A72</Color>
    <Color x:Key="SecondaryDark">#C8C3DC</Color>
    <Color x:Key="SecondaryContainer">#E4DFF9</Color>
    <Color x:Key="SecondaryContainerDark">#464359</Color>
    <Color x:Key="Tertiary">#7A4E67</Color>
    <Color x:Key="TertiaryDark">#EBB7D2</Color>
    <Color x:Key="TertiaryContainer">#FFD8EA</Color>
    <Color x:Key="TertiaryContainerDark">#613450</Color>

    <Color x:Key="Surface">#FBF9FF</Color>
    <Color x:Key="SurfaceDark">#131217</Color>
    <Color x:Key="SurfaceVariant">#E6E0EC</Color>
    <Color x:Key="SurfaceVariantDark">#47454F</Color>
    <Color x:Key="Background">#F3F2F8</Color>
    <Color x:Key="BackgroundDark">#131217</Color>

    <Color x:Key="Error">#BA1A1A</Color>
    <Color x:Key="ErrorDark">#FFB4AB</Color>
    <Color x:Key="ErrorContainer">#FFDAD6</Color>
    <Color x:Key="ErrorContainerDark">#93000A</Color>

    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#2A0A85</Color>
    <Color x:Key="OnPrimaryContainer">#190062</Color>
    <Color x:Key="OnPrimaryContainerDark">#E7DFFF</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="OnSecondaryDark">#2F2C42</Color>
    <Color x:Key="OnSecondaryContainer">#1B182C</Color>
    <Color x:Key="OnSecondaryContainerDark">#E4DFF9</Color>
    <Color x:Key="OnTertiary">#FFFFFF</Color>
    <Color x:Key="OnTertiaryDark">#47172F</Color>
    <Color x:Key="OnTertiaryContainer">#31101F</Color>
    <Color x:Key="OnTertiaryContainerDark">#FFD8EA</Color>
    <Color x:Key="OnSurface">#1B1B20</Color>
    <Color x:Key="OnSurfaceDark">#E5E1E9</Color>
    <Color x:Key="OnSurfaceVariant">#48454F</Color>
    <Color x:Key="OnSurfaceVariantDark">#C9C5D0</Color>
    <Color x:Key="OnError">#FFFFFF</Color>
    <Color x:Key="OnErrorDark">#690005</Color>
    <Color x:Key="OnErrorContainer">#410002</Color>
    <Color x:Key="OnErrorContainerDark">#FFDAD6</Color>
    <Color x:Key="OnBackground">#1B1B20</Color>
    <Color x:Key="OnBackgroundDark">#E5E1E9</Color>

    <Color x:Key="Outline">#79767F</Color>
    <Color x:Key="OutlineDark">#938F99</Color>
    <Color x:Key="OutlineVariant">#CAC5D0</Color>
    <Color x:Key="OutlineVariantDark">#47454F</Color>
    <Color x:Key="Shadow">#000000</Color>
    <Color x:Key="ShadowDark">#000000</Color>
    <Color x:Key="SurfaceTint">#512BD4</Color>
    <Color x:Key="SurfaceTintDark">#C9BEFF</Color>
    <Color x:Key="InverseSurface">#303034</Color>
    <Color x:Key="InverseSurfaceDark">#E5E1E9</Color>
    <Color x:Key="InverseOnSurface">#F3EFF4</Color>
    <Color x:Key="InverseOnSurfaceDark">#303034</Color>
    <Color x:Key="InversePrimary">#C9BEFF</Color>
    <Color x:Key="InversePrimaryDark">#512BD4</Color>

    <!-- Kept from the project template: other code and styles still use these names. -->
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>


    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
