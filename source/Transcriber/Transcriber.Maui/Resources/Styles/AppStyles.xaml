<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design tokens: every screen uses these, so the look changes in one place and follows light/dark. -->
    <Color x:Key="PageBackgroundLight">#F5F6FA</Color>
    <Color x:Key="PageBackgroundDark">#121214</Color>
    <Color x:Key="CardBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1C1C20</Color>
    <Color x:Key="CardStrokeLight">#E3E5EE</Color>
    <Color x:Key="CardStrokeDark">#2C2C33</Color>
    <Color x:Key="TextPrimaryLight">#1B1B1F</Color>
    <Color x:Key="TextPrimaryDark">#F2F2F5</Color>
    <Color x:Key="TextMutedLight">#6B6F80</Color>
    <Color x:Key="TextMutedDark">#9A9EB0</Color>
    <Color x:Key="SuccessColor">#1F9D55</Color>
    <Color x:Key="ErrorColor">#D64545</Color>
    <Color x:Key="WarningColor">#C77700</Color>
    <Color x:Key="ActiveRowLight">#ECE8FF</Color>
    <Color x:Key="ActiveRowDark">#2B2754</Color>

    <!-- Spacing scale: the only gaps that screens use. A gap between a label and its field is Xs, between rows of a card is Lg. -->
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <Thickness x:Key="CardPadding">20</Thickness>

    <!-- Sizes of controls: buttons and fields share one height, so a row of them lines up. -->
    <x:Double x:Key="ControlHeight">44</x:Double>
    <x:Double x:Key="SmallControlHeight">32</x:Double>
    <x:Double x:Key="ControlMinWidth">112</x:Double>
    <x:Int32 x:Key="ControlRadius">8</x:Int32>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
    </Style>


    <!-- Card container -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <!-- Text -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>
    <!-- The small text above a field. The gap below it is the same for every field. -->
    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- A warning or error line under a field or a group of buttons. -->
    <Style x:Key="Notice" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Buttons: regular ones are all 44 high, small ones 32. Each button is centred in its row, so it never stretches to the height of the text next to it. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinWidth}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinWidth}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <!-- For an action that sits inside a list or next to a field: Delete, Clear all, Copy all, the player buttons. -->
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HeightRequest" Value="{StaticResource SmallControlHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SmallControlHeight}" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>
    <!-- Text only, for a quiet action such as Any file type. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="{StaticResource SmallControlHeight}" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
</ResourceDictionary>
