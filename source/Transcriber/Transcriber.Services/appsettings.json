{
  "Audio": {
    "SampleRate": 16000,
    "Channels": 1
  },

  "Media": {
    "NativeExtensions": [".mp3", ".wav"],
    "FfmpegAudioExtensions": [".m4a", ".m4b", ".aac", ".flac", ".ogg", ".oga", ".opus", ".wma", ".aiff", ".aif", ".caf", ".amr", ".ac3", ".mka", ".mp2", ".wv", ".au"],
    "FfmpegVideoExtensions": [".mp4", ".m4v", ".mov", ".3gp", ".avi", ".mkv", ".webm", ".wmv", ".mpg", ".mpeg", ".flv"],
    "Ffmpeg": {
      "Windows": ["ffmpeg.exe"],
      "MacArm64": ["ffmpeg-arm64", "ffmpeg-x64", "ffmpeg"],
      "MacIntel": ["ffmpeg-x64", "ffmpeg-arm64", "ffmpeg"]
    }
  },

  "Models": {
    "Directory": null,
    "BundledDirectory": null,
    "DefaultModelId": "small",
    "SuggestedModelId": "medium-q5_0",
    "PracticeModelId": "small",
    "SpeechDetectionModelFile": "ggml-silero-v5.1.2.bin",
    "Catalog": [
      { "Id": "base", "DisplayName": "Base (fast, lowest accuracy)", "Type": "Base", "Quantization": "NoQuantization", "ApproxBytes": 148000000, "Tier": "Base" },
      { "Id": "small", "DisplayName": "Small (balanced)", "Type": "Small", "Quantization": "NoQuantization", "ApproxBytes": 488000000, "Tier": "Small" },
      { "Id": "small-q5_1", "DisplayName": "Small, compressed", "Type": "Small", "Quantization": "Q5_1", "ApproxBytes": 190000000, "Tier": "Small" },
      { "Id": "medium-q5_0", "DisplayName": "Medium, compressed (better)", "Type": "Medium", "Quantization": "Q5_0", "ApproxBytes": 539000000, "Tier": "Medium" },
      { "Id": "large-v3-turbo-q5_0", "DisplayName": "Large v3 turbo, compressed (best)", "Type": "LargeV3Turbo", "Quantization": "Q5_0", "ApproxBytes": 574000000, "Tier": "Large" }
    ]
  },

  "Languages": {
    "Catalog": [
      { "Code": "en", "Name": "English", "ConfidentFrom": "Base" },
      { "Code": "es", "Name": "Spanish (Español)", "ConfidentFrom": "Base" },
      { "Code": "pt", "Name": "Portuguese (Português)", "ConfidentFrom": "Small" },
      { "Code": "it", "Name": "Italian (Italiano)", "ConfidentFrom": "Small" },
      { "Code": "de", "Name": "German (Deutsch)", "ConfidentFrom": "Small" },
      { "Code": "nl", "Name": "Dutch (Nederlands)", "ConfidentFrom": "Small", "AdvisedUntil": "Medium" },
      { "Code": "fr", "Name": "French (Français)", "ConfidentFrom": "Medium" },
      { "Code": "pl", "Name": "Polish (Polski)", "ConfidentFrom": "Medium" },
      { "Code": "tr", "Name": "Turkish (Türkçe)", "ConfidentFrom": "Medium" },
      { "Code": "id", "Name": "Indonesian (Bahasa Indonesia)", "ConfidentFrom": "Medium" },
      { "Code": "sv", "Name": "Swedish (Svenska)", "ConfidentFrom": "Medium" },
      { "Code": "uk", "Name": "Ukrainian (Українська)", "ConfidentFrom": "Medium" }
    ]
  },

  "Transcription": {
    "NoSpeechThreshold": 0.6,
    "KeepModelLoadedMinutes": 5,
    "Hallucinations": [
      "blank_audio", "music", "silence", "applause",
      "thanks for watching", "thank you for watching",
      "subtitles by the amara.org community", "ondertiteld door de amara.org gemeenschap",
      "subtítulos realizados por la comunidad de amara.org",
      "ترجمة نانسي قنقر", "اشتركوا في القناة"
    ]
  },

  "SpeechPlanning": {
    "PaddingSeconds": 0.3,
    "MergeGapSeconds": 1.5,
    "MaxChunkSeconds": 300
  },

  "SpeechCoverage": {
    "MinMissingSeconds": 5,
    "MinShare": 0.75,
    "BridgeSeconds": 1
  },

  "Speakers": {
    "SegmentationModelFile": "pyannote-segmentation-3.0.int8.onnx",
    "EmbeddingModelFile": "3dspeaker-campplus-zh-en-16k.onnx",
    "ToolFileName": "sherpa-onnx-offline-speaker-diarization",
    "ClusterThreshold": 0.5,
    "MinDurationOn": 0.3,
    "MinDurationOff": 0.5,
    "MinorSpeakerShare": 0.05,
    "MinorSpeakerMaxSeconds": 20
  }
}
