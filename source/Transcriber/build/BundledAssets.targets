<Project>

  <!--
    Bundles what the app needs so users never install or download anything.

    ffmpeg: at build time the pinned release below is downloaded once (cached in obj/ffmpeg), verified against
    its SHA-256, unpacked, and copied next to the app together with its licence text.
    The binary comes from github.com/eugeneware/ffmpeg-static, tag b6.1.1 (tags are permanent).
    Windows ships one binary; macOS ships both Apple Silicon and Intel and the app picks at runtime.

    Whisper model: when a project sets BundleWhisperModel=true, the default "small" model is fetched from a
    pinned commit of the whisper.cpp model repository, verified, and copied to a models folder next to the app.
  -->

  <PropertyGroup>
    <FfmpegTag>b6.1.1</FfmpegTag>
    <FfmpegBaseUrl>https://github.com/eugeneware/ffmpeg-static/releases/download/$(FfmpegTag)</FfmpegBaseUrl>
    <FfmpegCacheDir>$(MSBuildProjectDirectory)\obj\ffmpeg\</FfmpegCacheDir>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <FfmpegAsset Include="win32-x64"
                 Gz="ffmpeg-win32-x64.gz" GzSha="8883a3dffbd0a16cf4ef95206ea05283f78908dbfb118f73c83f4951dcc06d77"
                 Licence="win32-x64.LICENSE" LicenceSha="8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903"
                 OutName="ffmpeg.exe" />
  </ItemGroup>

  <!-- A build for one Mac architecture bundles only its own ffmpeg; with no runtime identifier (dev builds, tests) both are kept. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <FfmpegAsset Include="darwin-arm64" Condition="!$(RuntimeIdentifier.EndsWith('-x64'))"
                 Gz="ffmpeg-darwin-arm64.gz" GzSha="8923876afa8db5585022d7860ec7e589af192f441c56793971276d450ed3bbfa"
                 Licence="darwin-arm64.LICENSE" LicenceSha="cb48bf09a11f5fb576cddb0431c8f5ed0a60157a9ec942adffc13907cbe083f2"
                 OutName="ffmpeg-arm64" />
    <FfmpegAsset Include="darwin-x64" Condition="!$(RuntimeIdentifier.EndsWith('-arm64'))"
                 Gz="ffmpeg-darwin-x64.gz" GzSha="929b375c1182d956c51f7ac25e0b2b0411fb01f6f407aa15c9758efeb4242106"
                 Licence="darwin-x64.LICENSE" LicenceSha="2e1d16c72fd74e12063776371da757322f8b77589386532f4fd8634bde7de1af"
                 OutName="ffmpeg-x64" />
  </ItemGroup>

  <UsingTask TaskName="VerifyAndUnpack" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <ExpectedSha256 ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <Gunzip ParameterType="System.Boolean" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string actual;
        using (var sha = SHA256.Create())
        using (var input = File.OpenRead(Source))
            actual = BitConverter.ToString(sha.ComputeHash(input)).Replace("-", "").ToLowerInvariant();

        if (!string.Equals(actual, ExpectedSha256, StringComparison.OrdinalIgnoreCase))
        {
            File.Delete(Source);
            Log.LogError("Checksum mismatch for " + Path.GetFileName(Source) + ": expected " + ExpectedSha256 + " but got " + actual);
            return false;
        }

        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        if (Gunzip)
        {
            using (var input = File.OpenRead(Source))
            using (var gz = new GZipStream(input, CompressionMode.Decompress))
            using (var output = File.Create(Destination))
                gz.CopyTo(output);
        }
        else
        {
            File.Copy(Source, Destination, true);
        }
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FetchFfmpeg" BeforeTargets="AssignTargetPaths" Condition="'@(FfmpegAsset)' != ''">
    <MakeDir Directories="$(FfmpegCacheDir)downloads" />

    <!-- Binary: download, verify checksum, unpack. Skipped when already cached. -->
    <DownloadFile Condition="!Exists('$(FfmpegCacheDir)%(FfmpegAsset.OutName)')"
                  SourceUrl="$(FfmpegBaseUrl)/%(FfmpegAsset.Gz)"
                  DestinationFolder="$(FfmpegCacheDir)downloads" Retries="5" RetryDelayMilliseconds="5000" />
    <VerifyAndUnpack Condition="!Exists('$(FfmpegCacheDir)%(FfmpegAsset.OutName)')"
                     Source="$(FfmpegCacheDir)downloads\%(FfmpegAsset.Gz)" ExpectedSha256="%(FfmpegAsset.GzSha)"
                     Destination="$(FfmpegCacheDir)%(FfmpegAsset.OutName)" Gunzip="true" />

    <!-- Licence text travels with the binary. -->
    <DownloadFile Condition="!Exists('$(FfmpegCacheDir)licenses\ffmpeg-LICENSE-%(FfmpegAsset.Identity).txt')"
                  SourceUrl="$(FfmpegBaseUrl)/%(FfmpegAsset.Licence)"
                  DestinationFolder="$(FfmpegCacheDir)downloads" Retries="5" RetryDelayMilliseconds="5000" />
    <VerifyAndUnpack Condition="!Exists('$(FfmpegCacheDir)licenses\ffmpeg-LICENSE-%(FfmpegAsset.Identity).txt')"
                     Source="$(FfmpegCacheDir)downloads\%(FfmpegAsset.Licence)" ExpectedSha256="%(FfmpegAsset.LicenceSha)"
                     Destination="$(FfmpegCacheDir)licenses\ffmpeg-LICENSE-%(FfmpegAsset.Identity).txt" Gunzip="false" />

    <ItemGroup>
      <Content Include="$(FfmpegCacheDir)%(FfmpegAsset.OutName)" Link="%(FfmpegAsset.OutName)" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(FfmpegCacheDir)licenses\ffmpeg-LICENSE-%(FfmpegAsset.Identity).txt" Link="licenses\ffmpeg-LICENSE-%(FfmpegAsset.Identity).txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Default Whisper model (ggml-small.bin, 488 MB). Pinned to an exact repository commit and checksum. -->
  <PropertyGroup>
    <WhisperModelCommit>5359861c739e955e79d9a303bcbc70fb988958b1</WhisperModelCommit>
    <WhisperModelFile>ggml-small.bin</WhisperModelFile>
    <WhisperModelSha>1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b</WhisperModelSha>
    <WhisperModelCacheDir>$(MSBuildProjectDirectory)\obj\models\</WhisperModelCacheDir>
  </PropertyGroup>

  <Target Name="FetchWhisperModel" BeforeTargets="AssignTargetPaths" Condition="'$(BundleWhisperModel)' == 'true'">
    <MakeDir Directories="$(WhisperModelCacheDir)downloads" />

    <DownloadFile Condition="!Exists('$(WhisperModelCacheDir)$(WhisperModelFile)')"
                  SourceUrl="https://huggingface.co/ggerganov/whisper.cpp/resolve/$(WhisperModelCommit)/$(WhisperModelFile)"
                  DestinationFolder="$(WhisperModelCacheDir)downloads" Retries="5" RetryDelayMilliseconds="5000" />
    <VerifyAndUnpack Condition="!Exists('$(WhisperModelCacheDir)$(WhisperModelFile)')"
                     Source="$(WhisperModelCacheDir)downloads\$(WhisperModelFile)" ExpectedSha256="$(WhisperModelSha)"
                     Destination="$(WhisperModelCacheDir)$(WhisperModelFile)" Gunzip="false" />

    <ItemGroup>
      <Content Include="$(WhisperModelCacheDir)$(WhisperModelFile)" Link="models\$(WhisperModelFile)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Silero voice activity detection model (ggml-silero-v5.1.2.bin, under 1 MB), pinned like the Whisper model. -->
  <PropertyGroup>
    <VadModelCommit>9ffd54a1e1ee413ddf265af9913beaf518d1639b</VadModelCommit>
    <VadModelFile>ggml-silero-v5.1.2.bin</VadModelFile>
    <VadModelSha>29940d98d42b91fbd05ce489f3ecf7c72f0a42f027e4875919a28fb4c04ea2cf</VadModelSha>
    <VadModelCacheDir>$(MSBuildProjectDirectory)\obj\vad\</VadModelCacheDir>
  </PropertyGroup>

  <Target Name="FetchVadModel" BeforeTargets="AssignTargetPaths">
    <MakeDir Directories="$(VadModelCacheDir)downloads" />

    <DownloadFile Condition="!Exists('$(VadModelCacheDir)$(VadModelFile)')"
                  SourceUrl="https://huggingface.co/ggml-org/whisper-vad/resolve/$(VadModelCommit)/$(VadModelFile)"
                  DestinationFolder="$(VadModelCacheDir)downloads" Retries="5" RetryDelayMilliseconds="5000" />
    <VerifyAndUnpack Condition="!Exists('$(VadModelCacheDir)$(VadModelFile)')"
                     Source="$(VadModelCacheDir)downloads\$(VadModelFile)" ExpectedSha256="$(VadModelSha)"
                     Destination="$(VadModelCacheDir)$(VadModelFile)" Gunzip="false" />

    <ItemGroup>
      <Content Include="$(VadModelCacheDir)$(VadModelFile)" Link="models\$(VadModelFile)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Speaker diarization models, pinned and verified like the others (about 30 MB together):
    pyannote segmentation 3.0 (int8, MIT) from a pinned commit of its Hugging Face mirror, and the 3D-Speaker
    CAM++ speaker embedding model (Apache 2.0) from the sherpa-onnx release assets, pinned by checksum.
  -->
  <PropertyGroup>
    <SegmentationModelUrl>https://huggingface.co/csukuangfj/sherpa-onnx-pyannote-segmentation-3-0/resolve/9403a6902bb58e3d5ae8c7e77c3422de279db2e0/model.int8.onnx</SegmentationModelUrl>
    <SegmentationModelFile>pyannote-segmentation-3.0.int8.onnx</SegmentationModelFile>
    <SegmentationModelSha>d582f4b4c6b48205de7e0643c57df0df5615a3c176189be3fc461e9d18827b5d</SegmentationModelSha>
    <SpeakerEmbeddingUrl>https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx</SpeakerEmbeddingUrl>
    <SpeakerEmbeddingFile>3dspeaker-campplus-zh-en-16k.onnx</SpeakerEmbeddingFile>
    <SpeakerEmbeddingSha>aa3cfc16963a10586a9393f5035d6d6b57e98d358b347f80c2a30bf4f00ceba2</SpeakerEmbeddingSha>
    <DiarizationCacheDir>$(MSBuildProjectDirectory)\obj\diarization\</DiarizationCacheDir>
  </PropertyGroup>

  <!--
    macOS only: sherpa-onnx's statically linked speaker diarization tool (about 28 MB, Apache 2.0, ONNX Runtime inside is MIT),
    taken from the official release archive pinned by checksum. A Mac Catalyst app cannot load the native library the Windows
    build uses, so the app runs this program instead. The archive is large, so only the one program is kept.
  -->
  <PropertyGroup>
    <SherpaCliVersion>v2.0.1</SherpaCliVersion>
    <SherpaCliArchive>sherpa-onnx-$(SherpaCliVersion)-osx-arm64-static-no-tts.tar.bz2</SherpaCliArchive>
    <SherpaCliSha>e2496931fd955ab449c2df1a6839e4c17cedf451e018cc3efd1a77180980c49b</SherpaCliSha>
    <SherpaCliTool>sherpa-onnx-offline-speaker-diarization</SherpaCliTool>
    <SherpaCliCacheDir>$(MSBuildProjectDirectory)/obj/sherpacli/</SherpaCliCacheDir>
  </PropertyGroup>

  <Target Name="FetchSherpaCli" BeforeTargets="AssignTargetPaths" Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'">
    <MakeDir Directories="$(SherpaCliCacheDir)" />

    <DownloadFile Condition="!Exists('$(SherpaCliCacheDir)$(SherpaCliTool)')"
                  SourceUrl="https://github.com/k2-fsa/sherpa-onnx/releases/download/$(SherpaCliVersion)/$(SherpaCliArchive)"
                  DestinationFolder="$(SherpaCliCacheDir)" Retries="5" RetryDelayMilliseconds="5000" />
    <Exec Condition="!Exists('$(SherpaCliCacheDir)$(SherpaCliTool)')"
          WorkingDirectory="$(SherpaCliCacheDir)"
          Command="echo &quot;$(SherpaCliSha)  $(SherpaCliArchive)&quot; | shasum -a 256 -c - &amp;&amp; tar -xjf $(SherpaCliArchive) --strip-components=2 &quot;sherpa-onnx-$(SherpaCliVersion)-osx-arm64-static-no-tts/bin/$(SherpaCliTool)&quot; &amp;&amp; chmod +x $(SherpaCliTool) &amp;&amp; rm -f $(SherpaCliArchive)" />

    <ItemGroup>
      <Content Include="$(SherpaCliCacheDir)$(SherpaCliTool)" Link="$(SherpaCliTool)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="FetchDiarizationModels" BeforeTargets="AssignTargetPaths">
    <MakeDir Directories="$(DiarizationCacheDir)downloads" />

    <DownloadFile Condition="!Exists('$(DiarizationCacheDir)$(SegmentationModelFile)')"
                  SourceUrl="$(SegmentationModelUrl)" DestinationFileName="$(SegmentationModelFile)"
                  DestinationFolder="$(DiarizationCacheDir)downloads" Retries="5" RetryDelayMilliseconds="5000" />
    <VerifyAndUnpack Condition="!Exists('$(DiarizationCacheDir)$(SegmentationModelFile)')"
                     Source="$(DiarizationCacheDir)downloads\$(SegmentationModelFile)" ExpectedSha256="$(SegmentationModelSha)"
                     Destination="$(DiarizationCacheDir)$(SegmentationModelFile)" Gunzip="false" />

    <DownloadFile Condition="!Exists('$(DiarizationCacheDir)$(SpeakerEmbeddingFile)')"
                  SourceUrl="$(SpeakerEmbeddingUrl)" DestinationFileName="$(SpeakerEmbeddingFile)"
                  DestinationFolder="$(DiarizationCacheDir)downloads" Retries="5" RetryDelayMilliseconds="5000" />
    <VerifyAndUnpack Condition="!Exists('$(DiarizationCacheDir)$(SpeakerEmbeddingFile)')"
                     Source="$(DiarizationCacheDir)downloads\$(SpeakerEmbeddingFile)" ExpectedSha256="$(SpeakerEmbeddingSha)"
                     Destination="$(DiarizationCacheDir)$(SpeakerEmbeddingFile)" Gunzip="false" />

    <ItemGroup>
      <Content Include="$(DiarizationCacheDir)$(SegmentationModelFile)" Link="models\$(SegmentationModelFile)" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="$(DiarizationCacheDir)$(SpeakerEmbeddingFile)" Link="models\$(SpeakerEmbeddingFile)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
